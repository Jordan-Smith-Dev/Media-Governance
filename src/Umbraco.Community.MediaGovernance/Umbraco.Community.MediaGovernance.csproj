<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <NoWarn>$(NoWarn);CS1998</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Umbraco.Community.MediaGovernance</Product>
    <PackageId>Umbraco.Community.MediaGovernance</PackageId>
    <Title>Media Governance</Title>
    <Description>Know which images in the Umbraco media library you can use. Tag the people pictured, record whether each person has given consent, and flag images that are expiring or lack consent from a Governance page in the Media section. Withheld images can be hidden from pages and blocked from the public.</Description>
    <PackageTags>umbraco;umbraco-marketplace;media;consent;gdpr;governance;compliance</PackageTags>
    <Authors>Jordan Smith</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Jordan Smith</Copyright>
    <PackageReadmeFile>README_nuget.md</PackageReadmeFile>
    <PackageIcon>MediaGovernance_logo.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Jordan-Smith-Dev/Media-Governance</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Jordan-Smith-Dev/Media-Governance</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="[17.8.1, 18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.8.1, 18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Common" Version="[17.8.1, 18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.8.1, 18.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.Community.MediaGovernance.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't include the client folder as part of the NuGet build -->
    <Content Remove="Client\**" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\README_nuget.md" Condition="Exists('..\..\docs\README_nuget.md')">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="Client\public\images\MediaGovernance_logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
